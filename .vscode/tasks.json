    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-debug",
            "type": "shell",
            "command": "make",
            "args": [ "debug" ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "clear": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "build-release",
            "type": "shell",
            "command": "make",
            "args": [ "release" ],
            "group": "build",
            "presentation": {
                "clear": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "build-asan",
            "type": "shell",
            "command": "make",
            "args": [ "asan" ],
            "group": "build",
            "presentation": {
                "clear": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}
